# Secrets — never commit
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Pipeline artefacts
output/*
!output/.gitkeep

# Your own input images stay local. Only the public-domain sample is tracked,
# so nobody's photo is committed to a public repo by accident.
input/*
!input/sample.jpg
!input/ATTRIBUTION.md

# Local blockchain state
blockchain/deployment.json

# OS
.DS_Store

# Stray session file from eth-tester
:memory:.ses
