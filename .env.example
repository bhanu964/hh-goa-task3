# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#   cp .env.example .env

# ─── Reverse image search (required) ─────────────────────────────────────────
# Free key (250 searches/month): https://serpapi.com/users/sign_up
SERPAPI_API_KEY=your_serpapi_key_here

# Also query Google Lens for pages hosting the exact same image.
# Strongest evidence, but costs one extra API credit per run.
SERPAPI_FETCH_EXACT=true

# Localisation of the Lens query.
SERPAPI_COUNTRY=us
SERPAPI_LANGUAGE=en
SERPAPI_TIMEOUT=60

# ─── Face matching ───────────────────────────────────────────────────────────
# Cosine similarity required to accept a candidate. See README for how this
# value was chosen; raise it for a stricter demo.
FACE_MATCH_THRESHOLD=0.45
FACE_DET_THRESHOLD=0.5
FACE_DET_SIZE=640
FACE_MODEL_PACK=buffalo_l

# How many candidate pages to download and face-check.
MAX_FACE_CHECKS=12

# ─── Blockchain ──────────────────────────────────────────────────────────────
# sepolia : public Ethereum testnet (needs a funded wallet; tx on Etherscan)
# local   : any JSON-RPC node on localhost (Anvil / Hardhat / Ganache)
# memory  : in-process py-evm chain, zero setup, ephemeral
BLOCKCHAIN_NETWORK=memory

# Public Sepolia endpoints work without a key; an Alchemy/Infura URL is fine too.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
LOCAL_RPC_URL=http://127.0.0.1:8545

# Testnet burner wallet ONLY. Generate one with: python scripts/new_wallet.py
# Never put a key holding real funds here.
WALLET_PRIVATE_KEY=

# Set after the first deploy to reuse the same contract on later runs.
CONTRACT_ADDRESS=

TX_TIMEOUT=300
